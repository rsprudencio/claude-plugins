# Copy this to terraform.tfvars and fill in your values.
# NEVER commit terraform.tfvars — it contains secrets.

aws_region    = "eu-central-1"
instance_type = "t3.small"

# Your public IP (use https://checkip.amazonaws.com to find it)
# IMPORTANT: Always use /32 for a single IP
allowed_cidrs = ["YOUR_IP/32"]

# Docker image (default pulls from GHCR after CI builds it)
jarvis_image = "ghcr.io/rsprudencio/jarvis:latest"

# Optional: Todoist API token (leave empty string to skip)
todoist_api_token = ""

# User management is done via mTLS client certificates, not Terraform.
# After deploy:
#   make ca-cert       # Extract CA cert (for NODE_EXTRA_CA_CERTS)
#   make ca-key        # Extract CA key (for signing client certs)
#   make client-cert USER=raph  # Generate client cert for a user
