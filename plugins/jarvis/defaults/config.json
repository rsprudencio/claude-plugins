{
  "vault_path": "__REQUIRED__",
  "file_format": "md",
  "vault_confirmed": false,
  "configured_at": "__REQUIRED__",
  "memory": {
    "chroma_url": "",
    "chroma_host": "localhost",
    "chroma_port": 8743,
    "chroma_ssl": false,
    "chroma_api_key": "",
    "chroma_auth_header": "X-Chroma-Token",
    "chroma_headers": {},
    "chroma_data_path": "~/.jarvis/db",
    "secret_detection": true,
    "importance_scoring": true,
    "recency_boost_days": 7,
    "default_importance": 0.5,
    "auto_extract": {
      "mode": "background",
      "min_turn_chars": 200,
      "max_transcript_lines": 500,
      "max_observations": 3,
      "dedup_threshold": 0.95,
      "debug": false
    },
    "per_prompt_search": {
      "enabled": true,
      "threshold": 0.5,
      "budget": 8000,
      "debug": false,
      "passive_retrieval_increment": 0.01
    },
    "chunking": {
      "enabled": true,
      "min_chunk_chars": 200,
      "max_chunk_chars": 1500,
      "heading_levels": [2, 3]
    },
    "scoring": {
      "enabled": true,
      "recency_half_life_days": 7.0,
      "type_weights": {},
      "concept_patterns": {}
    },
    "expansion": {
      "enabled": true,
      "max_expansion_terms": 5,
      "synonyms": {},
      "intent_patterns": []
    },
    "reranking": {
      "enabled": true,
      "candidate_count": 100,
      "top_k": 10,
      "alpha": 0.7,
      "max_latency_ms": 1000,
      "batch_size": 32
    },
    "worklog": {
      "enabled": true,
      "dedup_threshold": 0.7
    },
    "conflict_detection": {
      "enabled": true,
      "use_llm": false,
      "similarity_threshold": 0.7,
      "divergence_threshold": 0.4,
      "max_candidates": 10
    },
    "staleness": {
      "enabled": true,
      "penalty": 0.15
    },
    "telemetry": {
      "enabled": true,
      "log_reads": false,
      "log_writes": true,
      "probe_interval_seconds": 300
    },
    "pattern_detection": {
      "enabled": true,
      "scan_interval_seconds": 300,
      "similarity_threshold": 0.3,
      "promotion_threshold": 3,
      "max_candidates": 200,
      "candidate_expiry_days": 7,
      "lookback_minutes": 10,
      "merge_threshold": 0.7
    }
  },
  "promotion": {
    "importance_threshold": 0.85,
    "retrieval_count_threshold": 3,
    "age_importance_days": 30,
    "age_importance_score": 0.7,
    "on_promoted_file_deleted": "remove"
  },
  "todoist": {
    "api_token": ""
  },
  "paths": {
    "journal_jarvis": "journal/jarvis",
    "journal_daily": "journal/daily",
    "journal_summaries": "journal/jarvis/{YYYY}/summaries",
    "notes": "notes",
    "work": "work",
    "inbox": "inbox",
    "inbox_todoist": "inbox/todoist",
    "templates": "templates",
    "people": "people",
    "documents": "documents",
    "strategic": ".jarvis/strategic",
    "observations_promoted": ".jarvis/memories/observations",
    "patterns_promoted": ".jarvis/memories/patterns",
    "summaries_promoted": ".jarvis/memories/summaries",
    "learnings_promoted": ".jarvis/memories/learnings",
    "decisions_promoted": ".jarvis/memories/decisions",
    "worklogs_promoted": ".jarvis/memories/worklogs"
  }
}
