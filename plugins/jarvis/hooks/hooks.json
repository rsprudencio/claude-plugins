{
  "description": "Jarvis hooks: context enrichment + auto-extract + precompact dedup + session cleanup",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PLUGIN_DIR=\"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-}}\"; test -n \"${PLUGIN_DIR}\" && bash \"${PLUGIN_DIR}/hooks-handlers/session-cleanup.sh\" || true",
            "timeout": 2
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PLUGIN_DIR=\"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-}}\"; test -n \"${PLUGIN_DIR}\" && bash \"${PLUGIN_DIR}/hooks-handlers/context-enrichment.sh\" || true",
            "timeout": 3
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PLUGIN_DIR=\"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-}}\"; test -n \"${PLUGIN_DIR}\" && bash \"${PLUGIN_DIR}/hooks-handlers/precompact-dedup.sh\" || true",
            "timeout": 2
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PLUGIN_DIR=\"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-}}\"; test -n \"${PLUGIN_DIR}\" && bash \"${PLUGIN_DIR}/hooks-handlers/stop-extract.sh\" || true",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
