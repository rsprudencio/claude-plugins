# Python artifacts
**/__pycache__/
**/*.pyc
**/*.pyo
**/.venv/
**/*.egg-info/

# Tests (not needed in runtime image)
**/tests/
**/.pytest_cache/

# Git
.git/
.gitignore

# IDE / Editor
.serena/
.vscode/
.idea/

